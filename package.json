{
	"name": "@sigrea/react",
	"version": "0.7.1",
	"description": "React hooks for Sigrea molecules and signals.",
	"keywords": [
		"molecule",
		"react",
		"reactivity",
		"signals",
		"typescript"
	],
	"homepage": "https://github.com/sigrea/react#readme",
	"bugs": {
		"url": "https://github.com/sigrea/react/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sigrea/react.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vp dev --config playground/vite.config.ts",
		"prepack": "vp pack",
		"smoke": "node --input-type=module -e \"const mod = await import('@sigrea/react'); for (const key of ['useMolecule', 'useSignal']) { if (typeof mod[key] !== 'function') throw new Error(key + ' export is missing'); }\" && node -e \"const mod = require('@sigrea/react'); for (const key of ['useMolecule', 'useSignal']) { if (typeof mod[key] !== 'function') throw new Error(key + ' export is missing'); }\"",
		"cicheck": "vp check && vp test run && vp pack && vp run smoke",
		"prepare": "vp config --no-agent",
		"playground:build": "vp build --config playground/vite.config.ts",
		"notes": "vp exec changelogen --no-output",
		"release_version": "node scripts/release.js prepare",
		"push_release": "node scripts/release.js push"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@sigrea/core": "^0.7.0",
		"@types/node": "^24.19.2",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "6.1.0",
		"@vitest/coverage-v8": "catalog:",
		"changelogen": "^0.6.2",
		"jsdom": "^24.1.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"semver": "^7.7.3",
		"typescript": "5.9.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@sigrea/core": "^0.7.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.16.1"
}
